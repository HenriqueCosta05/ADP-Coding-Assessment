# Copy to .claude/hooks/env.local.sh (gitignored) only if `node` is not on PATH in non-interactive shells.
# Keep the line for the Node manager you use and delete the rest.

# nvm
# export NVM_DIR="$HOME/.nvm"; . "$NVM_DIR/nvm.sh" && nvm use --silent >/dev/null

# fnm
# eval "$(fnm env --shell bash)" && fnm use --silent-if-unchanged >/dev/null 2>&1

# volta
# export PATH="$HOME/.volta/bin:$PATH"
